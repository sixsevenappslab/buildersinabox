#!/usr/bin/env bash
# biab-browse — agent-facing CLI for the Builders in a Box browser pack.
# Opt-in (FEAT-017): only present on PATH after `biab pack add browser`.
# Multi-step workflows and the auto mode ladder are FEAT-030.
#
#   biab-browse open <url> read_text
#   biab-browse open <url> click <selector>
#   biab-browse open <url> fill <selector> <value>
#   biab-browse open <url> screenshot <path>
#   biab-browse run <url> < workflow.json
#   biab-browse --mode headful open <url> ...      (sites that block headless)
#
# Security model (FEAT-017 §1 Boundaries — unchanged by FEAT-030):
#   - The browser engine runs as the dedicated, unprivileged system user
#     `biab-browser` (nologin, no sudo) — never as the operator, never as root.
#   - Every run gets a fresh ephemeral profile (mktemp'd, deleted on exit) —
#     no inherited logins/cookies — unless the operator explicitly opts into a
#     named persisted profile with --profile <name>. In auto mode each retry
#     gets its own fresh ephemeral profile; a named profile is deliberately
#     reused across retries so an explicit login survives the ladder.
#   - Runs are serialized (flock): v1 does not run browsers in parallel, to
#     avoid OOM pressure on small boxes.
#   - The sandbox is never disabled by default. If the browser engine can't
#     start sandboxed, the run aborts with a clear error instead of silently
#     retrying unsandboxed (see driver/browse.mjs).
#   - Automatic fallback happens ONLY before any action has run (FEAT-030 R2).
#     A click or a form submission is never replayed against another mode.
#
# Why this script re-execs itself as root: an agent invokes this many times
# per session and cannot type a sudo password. install.sh installs a
# narrowly-scoped NOPASSWD sudoers rule limited to this exact binary path
# (see payload/pack/browser/install.sh). `sudo -n` fails fast instead of
# hanging on a TTY prompt that will never come if that rule is missing.
# Root here is used only to: create/tear down per-run scratch dirs with
# correct ownership, drop privilege to `biab-browser` for the actual browser
# process (sudo -u), and hand a screenshot artifact back to the operator.
# It never runs the browser process itself as root.

set -euo pipefail

PACK_ROOT="${BIAB_PACK_ROOT:-/opt/buildersinabox/payload/pack/browser}"
# shellcheck source=../lib.sh
source "${PACK_ROOT}/lib.sh"

usage() {
    cat <<'EOF'
Usage:
  biab-browse [--mode auto|desktop|iphone|headful] [--profile NAME] open URL VERB [ARGS...]
  biab-browse [--mode auto|desktop|iphone|headful] [--profile NAME] run URL < workflow.json

Verbs:
  read_text                 print the page's visible text
  click SELECTOR            click a CSS selector
  fill SELECTOR VALUE       fill a form field
  screenshot PATH           save a PNG under the operator's home

Workflow actions: fill, click, select, wait_for, read_text (maximum 20).

Modes:
  auto      desktop headless, then iPhone headless, then headful/Xvfb (default)
  desktop   desktop headless only
  iphone    Chromium with iPhone emulation only (not Safari)
  headful   Chromium under a temporary local Xvfb display only

Flags:
  --headful-xvfb             backwards-compatible alias for --mode headful
  --profile NAME             opt into a persisted profile; default is ephemeral

Automatic fallback happens only when the initial page is clearly blocked and
always before any action. BIAB never replays clicks or form submissions.
EOF
}

# ---------------------------------------------------------------------------
# Re-exec as root once, non-interactively. install.sh's sudoers rule keeps
# (env_keep) exactly BIAB_UNSAFE_NO_SANDBOX and BIAB_NAV_TIMEOUT_MS for this
# one command, scoped with `Defaults!/usr/local/bin/biab-browse` — sudo's
# default env_reset would otherwise silently strip them on every other
# elevation, which is the behaviour we want everywhere except here.
#
# `exec sudo` preserves stdin, which is what lets `run` take its workflow on
# stdin instead of argv: workflow values (passwords, search terms, anything a
# `fill` carries) must never be visible in a process listing.
# ---------------------------------------------------------------------------
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    exec sudo -n "$0" "$@"
fi

mode="auto"
mode_set=0
profile_name=""
command_name=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode)
            [[ $# -ge 2 ]] || { echo "biab-browse: --mode requires a value" >&2; exit 2; }
            mode="$2"; mode_set=1; shift 2
            ;;
        --mode=*) mode="${1#--mode=}"; mode_set=1; shift ;;
        --headful-xvfb)
            if [[ "$mode_set" -eq 1 && "$mode" != "headful" ]]; then
                echo "biab-browse: --headful-xvfb conflicts with --mode $mode" >&2
                exit 2
            fi
            mode="headful"; mode_set=1; shift
            ;;
        --profile)
            [[ $# -ge 2 ]] || { echo "biab-browse: --profile requires a value" >&2; exit 2; }
            profile_name="$2"; shift 2
            ;;
        --profile=*) profile_name="${1#--profile=}"; shift ;;
        -h|--help) usage; exit 0 ;;
        open|run) command_name="$1"; shift; break ;;
        *) echo "biab-browse: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

# Validate the mode BEFORE mapfile. `mapfile < <(cmd)` reports mapfile's own
# status, never the process substitution's, so a `|| exit $?` here would be
# dead code: an invalid mode would leave `attempts` empty and the run would
# end up exiting with the block code (6) instead of the usage code (2).
browser_mode_attempts "$mode" >/dev/null || exit 2
mapfile -t attempts < <(browser_mode_attempts "$mode")
[[ -n "$command_name" ]] || { usage >&2; exit 2; }
url="${1:-}"
[[ -n "$url" ]] || { usage >&2; exit 2; }
shift

verb=""
verb_args=()
workflow_file=""
if [[ "$command_name" == "open" ]]; then
    verb="${1:-}"
    [[ -n "$verb" ]] || { usage >&2; exit 2; }
    shift
    verb_args=("$@")
    case "$verb" in
        read_text) [[ ${#verb_args[@]} -eq 0 ]] || { usage >&2; exit 2; } ;;
        click) [[ ${#verb_args[@]} -eq 1 ]] || { usage >&2; exit 2; } ;;
        fill) [[ ${#verb_args[@]} -eq 2 ]] || { usage >&2; exit 2; } ;;
        screenshot) [[ ${#verb_args[@]} -eq 1 ]] || { usage >&2; exit 2; } ;;
        *) echo "biab-browse: unknown verb '$verb'" >&2; exit 2 ;;
    esac
else
    [[ $# -eq 0 ]] || { echo "biab-browse: run accepts the URL only; pass the workflow on stdin" >&2; exit 2; }
    verb="run"
fi

pack_is_installed || { echo "biab-browse: browser pack not fully installed" >&2; exit 1; }
operator_user="$(resolve_operator_user || true)"

mkdir -p "$BROWSER_HOME"
exec 9>"$BROWSER_LOCK_FILE"
flock 9

mkdir -p "$BROWSER_PROFILES_DIR" "$BROWSER_OUT_DIR"
chown "$BROWSER_USER:$BROWSER_USER" "$BROWSER_PROFILES_DIR" "$BROWSER_OUT_DIR"

cleanup_dirs=()
internal_shot=""
cleanup() {
    local path
    for path in "${cleanup_dirs[@]}"; do
        [[ -d "$path" ]] && rm -rf -- "$path"
    done
    [[ -n "$internal_shot" && -e "$internal_shot" ]] && rm -f -- "$internal_shot"
    [[ -n "$workflow_file" && -e "$workflow_file" ]] && rm -f -- "$workflow_file"
    # Never let the trap's last test decide the exit status under `set -e`.
    return 0
}
trap cleanup EXIT

if [[ -n "$profile_name" ]]; then
    validate_profile_name "$profile_name" || exit 2
    mkdir -p "${BROWSER_PROFILES_DIR}/named"
    named_profile="${BROWSER_PROFILES_DIR}/named/${profile_name}"
    mkdir -p "$named_profile"
    chown -R "$BROWSER_USER:$BROWSER_USER" "$named_profile"
else
    named_profile=""
fi

# Workflows are bounded before parsing and staged in a root-owned directory the
# browser user can read from but not write to. Values never reach argv or a
# success message.
#
# The file stays owned by ROOT and is only group-readable by biab-browser: the
# driver needs to read it, nothing needs to write it. See BROWSER_RUNTIME_DIR
# in lib.sh for why this does not live under $BROWSER_HOME like everything else
# the pack creates.
if [[ "$verb" == "run" ]]; then
    ensure_runtime_dir "$BROWSER_RUNTIME_DIR" || exit 1
    workflow_file="$(mktemp "${BROWSER_RUNTIME_DIR}/workflow-XXXXXX.json")"
    chmod 0640 "$workflow_file"
    chgrp "$BROWSER_USER" "$workflow_file"
    read_bounded_stdin "$workflow_file" "$BROWSER_MAX_WORKFLOW_BYTES" || exit 2
    verb_args=("$workflow_file")
fi

requested_dest=""
operator_home=""
if [[ "$verb" == "screenshot" ]]; then
    # Security-critical (FEAT-017 code review, screenshot arbitrary-write
    # finding): this script runs as root at this point. Without validation,
    # $requested_dest would be handed straight to a root-owned `install`
    # further down, letting any caller (including a prompt-injected agent)
    # write to any absolute path — ~/.ssh/authorized_keys, /etc/sudoers.d/*,
    # anywhere. Resolve to a canonical path and reject unless it's safely
    # under the operator's home. See validate_screenshot_dest() in lib.sh.
    requested_dest="${verb_args[0]}"
    [[ -n "$operator_user" ]] || { echo "biab-browse: could not resolve operator user for screenshot" >&2; exit 1; }
    operator_home="$(getent passwd "$operator_user" | cut -d: -f6)"
    requested_dest="$(validate_screenshot_dest "$requested_dest" "$operator_home")" || exit 1
    internal_shot="${BROWSER_OUT_DIR}/shot-$$-$(date +%s%N).png"
    verb_args=("$internal_shot")
fi

common_env=(
    "BIAB_NAV_TIMEOUT_MS=${BIAB_NAV_TIMEOUT_MS:-20000}"
    "BIAB_DETECT_INITIAL_BLOCK=1"
)
if [[ "${BIAB_UNSAFE_NO_SANDBOX:-0}" == "1" ]]; then
    # An env var alone is not a real "Ask First" gate (FEAT-017 §1
    # Boundaries): it's env_keep-listed in the sudoers rule, so any process
    # invoking biab-browse — including an unattended agent session — could
    # set it and reach --no-sandbox with no human involved. Require a
    # human-created sentinel file in addition; see
    # validate_unsafe_sandbox_gate() in lib.sh.
    validate_unsafe_sandbox_gate "$BROWSER_UNSAFE_SANDBOX_SENTINEL" || exit 1
    echo "biab-browse: WARNING — confirmed unsandboxed override enabled" >&2
    common_env+=("BIAB_UNSAFE_NO_SANDBOX=1")
fi

find_chrome() {
    find "$BROWSER_CACHE_DIR" -maxdepth 3 -type f -name chrome 2>/dev/null | head -1
}

status=6
selected_mode=""
for attempt_index in "${!attempts[@]}"; do
    attempt="${attempts[$attempt_index]}"
    if [[ -n "$named_profile" ]]; then
        profile_dir="$named_profile"
    else
        profile_dir="$(mktemp -d "${BROWSER_PROFILES_DIR}/ephemeral-XXXXXX")"
        cleanup_dirs+=("$profile_dir")
        chown -R "$BROWSER_USER:$BROWSER_USER" "$profile_dir"
    fi

    attempt_env=("${common_env[@]}" "BIAB_PROFILE_DIR=${profile_dir}")
    runner=(sudo -u "$BROWSER_USER")
    case "$attempt" in
        iphone-headless) attempt_env+=("BIAB_DEVICE=iphone") ;;
        desktop-headful)
            "${PACK_ROOT}/install.sh" --ensure-xvfb-fallback
            attempt_env+=("BIAB_HEADFUL=1")
            runner+=(xvfb-run --auto-servernum --server-args=-screen\ 0\ 1280x800x24)
            ;;
    esac

    chrome_exe="$(find_chrome)"
    sandbox_helper="$(find "$BROWSER_CACHE_DIR" -maxdepth 3 -type f -name chrome_sandbox 2>/dev/null | head -1)"
    [[ -n "$chrome_exe" ]] || { echo "biab-browse: chrome not found — reinstall the pack" >&2; exit 1; }
    attempt_env+=("BIAB_CHROME_EXE=${chrome_exe}")
    [[ -n "$sandbox_helper" ]] && attempt_env+=("BIAB_SANDBOX_HELPER=${sandbox_helper}")

    status=0
    if [[ "$verb" == "screenshot" ]]; then
        "${runner[@]}" env "${attempt_env[@]}" node "${BROWSER_DRIVER_DIR}/browse.mjs" \
            "$url" "$verb" "${verb_args[@]}" >/dev/null || status=$?
    else
        "${runner[@]}" env "${attempt_env[@]}" node "${BROWSER_DRIVER_DIR}/browse.mjs" \
            "$url" "$verb" "${verb_args[@]}" || status=$?
    fi

    if [[ "$status" -eq 0 ]]; then
        selected_mode="$attempt"
        break
    fi
    if [[ "$status" -ne 6 || "$mode" != "auto" ]]; then
        exit "$status"
    fi
    if (( attempt_index + 1 < ${#attempts[@]} )); then
        echo "biab-browse: retrying initial navigation with ${attempts[$((attempt_index + 1))]}" >&2
    fi
done

[[ "$status" -eq 0 ]] || exit "$status"
if [[ "$mode" == "auto" ]]; then
    echo "biab-browse: navigation mode: $selected_mode" >&2
fi

if [[ "$verb" == "screenshot" ]]; then
    # Recheck-then-use, immediately before the privileged copy, to close the
    # TOCTOU window between validation (above) and use (here): the browser
    # navigation in between can take up to BIAB_NAV_TIMEOUT_MS per attempt
    # (default 20s, and auto mode may make three attempts), which is ample
    # time for an attacker with local access to swap a path component for a
    # symlink after the earlier check ran. Re-resolving now catches that.
    final_dest="$(validate_screenshot_dest "$requested_dest" "$operator_home")" || exit 1
    # Second TOCTOU: $internal_shot lives in a directory owned by the
    # low-trust biab-browser user (the browser engine we just ran as that
    # user wrote the PNG there). Verify it is still a regular file (not a
    # symlink) owned by biab-browser immediately before the root-privileged
    # copy reads it.
    if [[ -f "$internal_shot" && ! -L "$internal_shot" ]] \
       && [[ "$(stat -c '%U' "$internal_shot" 2>/dev/null || true)" == "$BROWSER_USER" ]]; then
        install -D -o "$operator_user" -g "$operator_user" -m 0644 "$internal_shot" "$final_dest"
        printf '{"ok":true,"action":"screenshot","path":"%s"}\n' "$final_dest"
    else
        echo "biab-browse: refusing screenshot handoff — invalid internal capture" >&2
        exit 1
    fi
fi
