# candidate night-shift rules (measurement draft, forbidden only)
prefix_rule(pattern=["gh",["api","auth","secret","variable","release","workflow","run","repo","ruleset","extension","alias","config","codespace","gpg-key","ssh-key","cache","org"]], decision="forbidden")
prefix_rule(pattern=["gh","pr",["merge","close","edit","ready","reopen","review","comment","lock","revert","update-branch"]], decision="forbidden")
prefix_rule(pattern=["git","push",["--force","-f","--force-with-lease","--delete","-d","--mirror","--all","--tags","--prune"]], decision="forbidden")
prefix_rule(pattern=["git","push","origin",["main","master","pre","dev","Main","Dev","HEAD:main","HEAD:master","HEAD:dev","HEAD:pre","+main","+dev","refs/heads/main","refs/heads/dev","refs/heads/master"]], decision="forbidden")
prefix_rule(pattern=["git","push","-u","origin",["main","master","pre","dev"]], decision="forbidden")
prefix_rule(pattern=["git","push"], decision="prompt")
prefix_rule(pattern=["git",["remote","config","tag","credential","-C","-c","--git-dir","--work-tree","--exec-path","--config-env","--namespace"]], decision="forbidden")
prefix_rule(pattern=["git","checkout",["main","master","pre","dev"]], decision="forbidden")
prefix_rule(pattern=["git","merge"], decision="forbidden")
prefix_rule(pattern=[["curl","wget","sudo","su","eval","ssh","scp","nc","ncat","socat","base64","python","python3","perl","ruby","node","env"]], decision="forbidden")
prefix_rule(pattern=["rm",["-rf","-fr","-r","-R","-Rf","-f","--recursive","--force","--no-preserve-root"]], decision="forbidden")
prefix_rule(pattern=[["mkfs","wipefs","sgdisk","parted","fdisk","dd","chmod","chown","shutdown","reboot"]], decision="forbidden")
prefix_rule(pattern=[["cat","less","head","tail","cp","mv","sed","tee","grep"],["~/.config/gh/hosts.yml","~/.ssh/id_ed25519",".git/config"]], decision="forbidden")
